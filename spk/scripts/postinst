#!/bin/sh
# postinst —— 初始化数据目录与 .env(向导值经 wizard_* 环境变量注入)
ENV_FILE="${SYNOPKG_PKGVAR}/.env"
mkdir -p "$SYNOPKG_PKGVAR"

if [ ! -f "$ENV_FILE" ]; then
    # 从模板生成:先剔除要注入的三行,再追加向导值(避免 sed 注入/转义问题)
    {
        grep -vE '^(PB_API_PORT|PB_DATA_DIR|PB_ADMIN_PASSWORD)=' \
            "${SYNOPKG_PKGDEST}/env.example"
        printf 'PB_API_PORT=%s\n'       "${wizard_host_port:-12345}"
        printf 'PB_DATA_DIR=%s\n'       "${wizard_data_dir:-/volume1/docker/pigeonbox}"
        printf 'PB_ADMIN_PASSWORD=%s\n' "${wizard_admin_password:-}"
    } > "$ENV_FILE"
    chmod 600 "$ENV_FILE"
fi

# 数据目录必须是「卷下的子目录」(如 /volume1/docker/pigeonbox)——synology#149:
# 卷根本身(/volume1)或系统目录(/etc 等)一旦被递归 chown 会改掉整个卷/系统属主,
# 破坏面远超本套件。判据与向导同款:卷族前缀 + 子目录 + 拒 .. 穿越。
valid_data_dir() {
    case "$1" in
        */../*|*/..|../*|..) return 1 ;;
    esac
    printf '%s' "$1" | grep -Eq '^/volume[^/]+/.+$'
}

DATA_DIR=$(sed -n 's|^PB_DATA_DIR=||p' "$ENV_FILE" | head -n 1)
if [ -n "$DATA_DIR" ] && [ "$DATA_DIR" != "/" ]; then
    if valid_data_dir "$DATA_DIR"; then
        mkdir -p "$DATA_DIR"
        # 后端容器以 uid 1000 运行,bind 挂载目录属主必须匹配,否则库/密钥写不进。
        # ⚠️ 只改目录自身,**不要 -R**(对齐 start-stop-status 的做法):递归 chown
        # 是 O(全部文件) 的属主风暴,且会改掉用户手工放进数据目录的文件所有权。
        chown 1000:1000 "$DATA_DIR" 2>/dev/null || true
    elif [ -d "$DATA_DIR" ]; then
        # 存量非卷路径(如历史自定义挂载)不回溯拒绝——升级不因旧路径被拒启;
        # 但绝不对其 chown(路径不经校验就不动属主)。
        echo "数据目录不在「卷下子目录」形态,升级放行但不改属主: $DATA_DIR" >&2
    else
        echo "数据目录必须是卷下的子目录（如 /volume1/docker/pigeonbox；卷根/系统目录不可用）: $DATA_DIR" >&2
        exit 1
    fi
fi

cat > "$SYNOPKG_TEMP_LOGFILE" <<EOF
<p>PigeonBox 安装完成。</p>
<p>启动套件后浏览器访问 <strong>http://NAS的IP:${wizard_host_port:-12345}</strong></p>
<p>默认管理员 <strong>admin</strong>,密码为安装向导中设置的值(必填;遗失可卸载重装,数据目录保留)。</p>
EOF
exit 0
