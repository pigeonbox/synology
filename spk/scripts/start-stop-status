#!/bin/sh
# start-stop-status —— 套件生命周期:start/stop/status(+log 供 synopkg log)
# 编排:compose.yml 随包装入 SYNOPKG_PKGDEST(升级随包更新);
#       .env 在 SYNOPKG_PKGVAR(@appdata,升级/重装保留)。

# ── shellkit POSIX 子集（设备侧唯一可用的 shellkit 形态）──────────────────
# 落点探测：① 环境变量 PB_SHELLKIT_POSIX ② 脚本同目录 lib/ ③ 脚本同目录
#           ④ DSM 套件目录（装机后的绝对路径）
# ⚠️ 缺失即 fail-closed 退 5：设备侧脚本是「装机即执行」的，装坏了现场补不了
#    （与 fnOS 预接线「缺了就优雅降级」不同——那边是可选功能，这边是生命周期本体）。
_sk_dir="$(dirname "$0")"
_sk_lib=""
for _sk_c in \
    "${PB_SHELLKIT_POSIX:-}" \
    "${_sk_dir}/lib/shellkit-posix.sh" \
    "${_sk_dir}/shellkit-posix.sh" \
    "/var/packages/pigeonbox/scripts/lib/shellkit-posix.sh"
do
    if [ -n "$_sk_c" ] && [ -r "$_sk_c" ]; then _sk_lib="$_sk_c"; break; fi
done
if [ -z "$_sk_lib" ]; then
    echo "缺 shellkit POSIX 子集（装的是不完整的包）" >&2
    exit 5
fi
# shellcheck disable=SC1090  # 动态源：库路径按候选探测，shellcheck 跟不了
. "$_sk_lib"

PKG="pigeonbox"
# SYNOPKG_DOCKER_BIN 仅供测试注入 mock(DSM 运行环境不会设置此变量)
DOCKER="${SYNOPKG_DOCKER_BIN:-/usr/local/bin/docker}"
[ -x "$DOCKER" ] || DOCKER="$(command -v docker 2>/dev/null)"
if [ -z "$DOCKER" ]; then
    [ "$1" = "status" ] && exit 4
    echo "未找到 docker 命令" >&2
    exit 1
fi

PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
COMPOSE_FILE="${PKGDEST}/compose.yml"
ENV_FILE="${PKGVAR}/.env"
LOG_FILE="${PKGVAR}/pigeonbox.log"

compose() {
    # -p 固定项目名,保证容器/网络命名稳定,与 Container Manager 手工项目隔离
    "$DOCKER" compose -p pigeonbox --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

case "$1" in
    start)
        if [ ! -f "$ENV_FILE" ]; then
            # 兜底:向导流程未生成时用默认值(理论上 postinst 已生成)
            fs_ensure_dir "$PKGVAR"
            cp "${PKGDEST}/env.example" "$ENV_FILE"
            chmod 600 "$ENV_FILE"
        fi
        DATA_DIR=$(sed -n 's|^PB_DATA_DIR=||p' "$ENV_FILE" | head -n 1)
        if [ -n "$DATA_DIR" ] && [ "$DATA_DIR" != "/" ]; then
            fs_ensure_dir "$DATA_DIR" 2>/dev/null || true
            # ⚠️ 只改目录本身，**不要 -R**（2026-11-06）：容器以 1000:1000 写入，
            # 目录里既有文件的属主本就正确；每次 start 全量 chown 是 O(全部文件)
            # 的系统调用风暴（几十 GB 数据目录在低端机型可达数十秒 ⇒ 套件中心判
            # 「启动超时」），且会把用户手工放进数据目录的文件所有权一并改掉。
            # 仅在目录自身属主不对时才动（stat 缺失则照旧执行一次，仍是非递归）。
            _cur=$(stat -c '%u:%g' "$DATA_DIR" 2>/dev/null || echo "")
            [ "$_cur" = "1000:1000" ] || chown 1000:1000 "$DATA_DIR" 2>/dev/null || true
        fi
        # Container Manager 守护进程偶发未就绪(开机竞态):最多等 30 秒
        i=0
        while ! "$DOCKER" info >/dev/null 2>&1; do
            i=$((i + 1))
            [ "$i" -ge 6 ] && { echo "docker daemon 未就绪(Container Manager 是否已启动?)" >&2; exit 1; }
            sleep 5
        done
        compose up -d >>"$LOG_FILE" 2>&1 || exit 1
        exit 0
        ;;
    stop)
        # 不带 -v:数据在 bind 挂载目录,compose down 本就不删;显式保数据语义
        compose down --remove-orphans >>"$LOG_FILE" 2>&1 || true
        exit 0
        ;;
    status)
        # LSF 语义:0=运行中,3=未运行,4=未知
        #
        # ⚠️ 必须**两个容器都在跑**才算运行中（2026-11-06）：此前一条 docker ps
        # 里写两个 --filter name=…（同键多值在 docker 里是 OR）⇒ 只起了一个也报
        # 「运行中」——半死状态在套件中心完全看不出来（前端挂了用户看到白屏，
        # 后端挂了用户看到 502，而面板显示"运行中"）。
        for _c in pigeonbox-server pigeonbox-frontend; do
            _run=$("$DOCKER" ps --filter "name=${_c}" --filter "status=running" -q 2>/dev/null)
            [ -n "$_run" ] || exit 3
        done
        exit 0
        ;;
    log)
        echo "$LOG_FILE"
        exit 0
        ;;
esac
exit 1
